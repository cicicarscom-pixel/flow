{
  "expo": {
    "name": "Workigom Flow",
    "slug": "flow",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "workigomflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.workigom.flow",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Flow AI'a sesli komut verebilmeniz için mikrofon kullanılır.",
        "NSMicrophoneUsageDescription": "Flow AI'a sesli komut verebilmeniz için mikrofon kullanılır."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.workigom.flow",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Flow AI'a sesli komut verebilmeniz için mikrofon kullanılır.",
          "speechRecognitionPermission": "Flow AI'a sesli komut verebilmeniz için mikrofon kullanılır."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "bb7e7d28-5325-4a50-ae1e-7b134bdda455"
      }
    },
    "owner": "workigom"
  }
}
